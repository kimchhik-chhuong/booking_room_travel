# API Configuration (Development)
# For local development, each team member should create their own .env file
# and replace the values below with their local configuration

# Local development
API_BASE_URL=http://localhost:8000/api

# Staging (example - replace with your staging URL)
# API_BASE_URL=https://staging-api.yourdomain.com/api

# Production (example - replace with your production URL)
# API_BASE_URL=https://api.yourdomain.com/api

# Add other environment-specific variables below
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# SENTRY_DSN=your_sentry_dsn
